@page "/tickets"
@rendermode InteractiveServer
@using Client.Components.Kanban
@using Shared.Enums.Ticket

<div class="page">
    <div class="header segment">
        <h1>Support Ticket Classifier Kanban Board</h1>
    </div>
    <div class="body segment">
        <div class="column-container">
            @{
                var openTickets = _tickets.Where(t => t.Status == TicketStatus.Open).ToList();
                var responeTickets = _tickets.Where(t => t.Status == TicketStatus.PendingCustomerResponse).ToList();
                var closedTickets = _tickets.Where(t => t.Status == TicketStatus.Closed).ToList();
            }

            <Column Name="OPEN" Tickets="openTickets" ColumnStatus="TicketStatus.Open" AddTicketsEvent="OnNewTicketAdded" CanAddTickets/>
            <Column Name="AWAITING CUSTOMER RESPONSE" Tickets="responeTickets" ColumnStatus="TicketStatus.PendingCustomerResponse"/>
            <Column Name="CLOSED" Tickets="closedTickets" ColumnStatus="TicketStatus.Closed"/>
        </div>
    </div>
    <div class="footer segment"></div>
</div>

<TicketForm @bind-IsVisible="_existingTicketDialogShowing" Ticket="_selectedTicket" />
<TicketForm @bind-IsVisible="_newTicketDialogShowing" />