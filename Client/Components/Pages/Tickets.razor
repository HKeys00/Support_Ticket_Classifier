@page "/tickets"
@rendermode InteractiveServer
@using Client.Components.Kanban

<div class="page">
    <div class="header segment">
        <h1>Support Ticket Classifier Kanban Board</h1>
    </div>
    <div class="body segment">
        <div class="column-container">
            <Column Name="OPEN" Tickets="_tickets" AddTicketsEvent="OnNewTicketAdded" CanAddTickets/>
            <Column Name="AWAITING CUSTOMER RESPONSE" Tickets="_tickets"/>
            <Column Name="CLOSED" Tickets="_tickets"/>
        </div>
    </div>
    <div class="footer segment"></div>
</div>

@if (_selectedTicket != null)
{
    <TicketDetails Ticket="_selectedTicket"/>
}

