@page "/tickets"
@using Client.Components.Kanban

<div class="page">
    <div class="header segment">
        <h1>Support Ticket Classifier Kanban Board</h1>
    </div>
    <div class="body segment">
        <div class="column-container">
            <Column Name="TO DO" Tickets="_tickets" CanAddTickets/>
            <Column Name="IN PROGRESS" Tickets="_tickets"/>
            <Column Name="IN QA" Tickets="_tickets"/>
            <Column Name="DONE" Tickets="_tickets"/>
        </div>
    </div>
    <div class="footer segment"></div>
</div>
