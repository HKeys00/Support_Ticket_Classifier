@if (IsVisible) {
    <div class="overlay">
        <div class="dialog">
            @ChildContent
        </div>
    </div>
}

@code {

    /// <summary>
    /// Gets or sets the content to show inside the dialog.
    /// </summary>
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    /// <summary>
    /// Gets or sets whether the dialog is visible.
    /// </summary>
    [Parameter]
    public bool IsVisible { get; set; }
}