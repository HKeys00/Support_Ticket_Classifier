@using Client.Components.Common;
@using Shared.Enums.Ticket;
<Dialog IsVisible="@IsVisible">
    <div class="header">
        <h1>Edit Ticket</h1>
    </div>
    <TicketForm Model="_ticketModel" OnValidSubmit="Submit" FormName="NewTicket">
    </TicketForm>
    <LoadingSpinner IsVisible="@_isLoading" />
    <div class="footer">
        <div class="priority">

        </div>
        <div class="action-buttons">
            <button class="cancel" @onclick=Cancel type="button">Cancel</button>
            <button class="submit" type="submit" form="NewTicket">Save</button>
        </div>
    </div>
</Dialog>
