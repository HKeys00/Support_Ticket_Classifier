<div class="column">
    <div class="column-header">
        <p class="column-name">@Name</p>
        <p class="column-ticket-count">@_ticketCount</p>
    </div>
    <div class="tickets">
        @foreach(var t in Tickets) 
        {
            var ticket = t;
            <Ticket @bind-Data="ticket"/>
        }
    </div>
    @if(CanAddTickets){
        <div class="add-tickets">
            <p>+ Add Tickets</p>
        </div>
    }
</div>
