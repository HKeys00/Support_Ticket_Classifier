<div class="column" @ondragover="OnDragOver" @ondrop="OnDrop">
    <div class="column-header">
        <p class="column-name">@Name</p>
        <p class="column-ticket-count">@_ticketCount</p>
    </div>
    <div class="tickets">
        @foreach(var t in Tickets) 
        {
            var ticket = t;
            <Ticket @bind-Data="ticket"/>
        }
    </div>
    <div class="column-footer">
        @if (CanAddTickets)
        {
            <button type="button" class="add-tickets" @onclick="() => OnAddTicketClicked()">
                <p>+ Create Ticket</p>
            </button>
        }
    </div>
</div>