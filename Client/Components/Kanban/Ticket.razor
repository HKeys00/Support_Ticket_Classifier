<div class="ticket-container"
     draggable="true"
     @ondragstart="OnDragStart" @onclick=OnTicketClicked>
    <h5>@Data.Subject</h5>
    <div class="ticket-info">
        <div class="half-container left-side">
            <img class="ticket-type icon" src="@_ticketTypeIconPath"/>
            <p>SUP-@Data.Id.ToString("00")</p>
        </div>
        <div class="half-container right-side">
            <img class="ticket-priority icon" src="@_ticketPriorityIconPath" />
            <img class="ticket-assignee icon" src="images/profile.png"/>
        </div>
    </div>
</div>
