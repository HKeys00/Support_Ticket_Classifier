@using Client.Components.Common;        
@using Shared.Enums.Ticket;
<Dialog IsVisible="@IsVisible">
    <EditForm Model="_ticketModel" OnValidSubmit="Submit" FormName="NewTicket">
        <ObjectGraphDataAnnotationsValidator />
        <div class="header">
            @if (_isNew)
            {
                <h1>Create Ticket</h1>
            }
            else
            {
                <h1>Edit Ticket</h1>
            }
        </div>

        <div class="body">
            <label>
                Ticket Type
                <InputSelect id="type" TValue="TicketType" @bind-Value="_ticketModel.Type">
                    <option value="@TicketType.ProductInquiry">Product Inquiry</option>
                    <option value="@TicketType.RefundRequest">Refund Request</option>
                    <option value="@TicketType.CancellationRequest">Cancellation Request</option>
                    <option value="@TicketType.BillingInquiry">Billing Inquiry</option>
                    <option value="@TicketType.TechnicalIssue">Technical Issue</option>
                </InputSelect>
                <ValidationMessage For="@(() => _ticketModel.Type)" />
            </label>

            <label>
                Subject:
                <InputText id="subject" @bind-Value="_ticketModel.Subject" />
                <ValidationMessage For="@(() => _ticketModel.Subject)" />
            </label>

            <div class="customer-details">
                <h5>Customer Details</h5>
                <label>
                    Email:
                    <InputText @bind-Value="_ticketModel.Customer.Email" />
                    <ValidationMessage For="@(() => _ticketModel.Customer.Email)" />
                </label>
                <label>
                    Name:
                    <InputText @bind-Value="_ticketModel.Customer.Name" />
                    <ValidationMessage For="@(() => _ticketModel.Customer.Name)" />
                </label>
            </div>

            <div class="ticket-details">
                <label>
                    Channel:
                    <InputSelect @bind-Value="_ticketModel.Channel">
                        <option value="@TicketChannel.SocialMedia">Social Media</option>
                        <option value="@TicketChannel.Email">Email</option>
                        <option value="@TicketChannel.Phone">Phone</option>
                        <option value="@TicketChannel.Chat">Chat</option>
                    </InputSelect>
                    <ValidationMessage For="@(() => _ticketModel.Channel)" />
                </label>

                <label>
                    Product:
                    <InputText @bind-Value="_ticketModel.ProductPurchased" />
                    <ValidationMessage For="@(() => _ticketModel.ProductPurchased)" />
                </label>

                <label>
                    Date Of Purchase:
                    <InputDate @bind-Value="_ticketModel.DateOfPurchase" />
                    <ValidationMessage For="@(() => _ticketModel.DateOfPurchase)" />
                </label>

                <label>
                    Description:
                    <InputTextArea @bind-Value="_ticketModel.Description" />
                    <ValidationMessage For="@(() => _ticketModel.Description)" />
                </label>
            </div>
        </div>

        <div class="footer">
            <button class="cancel" @onclick=Cancel type="button">Cancel</button>
            @if (_isNew)
            {
                <button class="submit" type="submit">Submit</button>
            }
            else
            {
                <button class="submit" type="submit">Save</button>
            }
        </div>
    </EditForm>
</Dialog>
